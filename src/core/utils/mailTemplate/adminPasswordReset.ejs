<!DOCTYPE html>
<html>
  <body style="margin:0;padding:24px;background:#f3f4f6;font-family:Arial,Helvetica,sans-serif;color:#111827;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;background:#ffffff;border-radius:8px;overflow:hidden;">
            <tr>
              <td style="background:#000000;color:#ffffff;padding:20px 24px;font-size:18px;font-weight:bold;">
                GloUp Admin Portal
              </td>
            </tr>
            <tr>
              <td style="padding:24px;font-size:14px;line-height:22px;">
                <p style="margin:0 0 12px;font-size:16px;font-weight:bold;">Password reset requested</p>
                <p style="margin:0 0 12px;">
                  Someone asked to reset the password of the admin account
                  <strong><%= adminName %></strong> (<%= adminEmail %>).
                </p>
                <p style="margin:0 0 20px;">
                  Click the button below to choose a new password. This link works once and
                  expires in <%= expiresInMinutes %> minutes.
                </p>
                <p style="margin:0 0 20px;">
                  <a href="<%= resetUrl %>" style="display:inline-block;background:#000000;color:#ffffff;text-decoration:none;padding:10px 20px;border-radius:6px;font-weight:bold;">Reset password</a>
                </p>
                <p style="margin:0 0 8px;color:#6b7280;font-size:12px;">If the button doesn't work, copy this link into your browser:</p>
                <p style="margin:0 0 20px;font-size:12px;word-break:break-all;"><a href="<%= resetUrl %>"><%= resetUrl %></a></p>
                <p style="margin:0;color:#6b7280;font-size:12px;">
                  If nobody on your team asked for this, ignore this email. The password stays the same.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
